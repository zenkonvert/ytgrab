<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Networking (downloading video/audio + fetching latest yt-dlp binary) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Foreground service so long downloads survive backgrounding -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- Android 13+ needs explicit runtime permission to show progress notifications -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
        Storage: we save to public Downloads/Music via MediaStore (scoped storage),
        which needs NO special permission on Android 10+ (API 29+).
        For Android 7-9 (API 24-28) we still need legacy WRITE_EXTERNAL_STORAGE.
    -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- Prevent battery optimizer from killing long downloads (user-grantable, optional) -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:name=".YtGrabApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.YTGrab"
        android:requestLegacyExternalStorage="true"
        android:usesCleartextTraffic="false"
        tools:targetApi="35">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.YTGrab">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Allows "Share" from YouTube/other apps directly into YTGrab -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <service
            android:name=".core.DownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

    </application>
</manifest>
